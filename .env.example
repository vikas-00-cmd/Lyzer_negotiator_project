# ── Database ─────────────────────────────────────────────────────────────
# Local Development (SQLite):
DATABASE_URL=sqlite:///./negotiation.db
# Cloud Deployment (Render PostgreSQL):
# DATABASE_URL=postgresql://your_user:your_password@your_host/your_db

# ── Lyzr Agent Studio ────────────────────────────────────────────────────
# Get your API key from: https://studio.lyzr.ai > Settings > API Keys
LYZR_API_KEY=your_lyzr_api_key_here

# Official Lyzr Agent API host (do not change)
LYZR_API_URL=https://agent-prod.studio.lyzr.ai

# Agent IDs from studio.lyzr.ai — your Buyer and Vendor agents
LYZR_BUYER_AGENT_ID=your_buyer_agent_id_here
LYZR_VENDOR_AGENT_ID=your_vendor_agent_id_here

# Set to true to route negotiation turns through Lyzr Agent Studio
USE_LYZR_AGENTS=true

# ── Groq (optional only for local development) ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Negotiation parameters ───────────────────────────────────────────────
MAX_ROUNDS=10
ARBITER_MAX_RETRIES=3
DISCOUNT_FACTOR=0.85
CONTRACT_OUTPUT_DIR=./contracts
